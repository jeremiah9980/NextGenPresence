# Copy to .env and fill in your values
# cp .env.example .env

# Ring credentials (only needed by ring_logger.py)
RING_USERNAME=your@email.com
RING_PASSWORD=yourpassword
RING_TOKEN_FILE=/home/pi/.nextgen_ring_token.json
RING_POLL_SECONDS=30

# Unified SQLite database path
NEXTGEN_DB=/home/pi/nextgen.db

# Network to ARP-scan for WiFi presence
WIFI_SUBNET=192.168.1.0/24

# MQTT broker address
MQTT_HOST=localhost
MQTT_PORT=1883
